generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PermissionKey {
  USERS_MANAGE
  CUSTOMERS_READ
  CUSTOMERS_CREATE
  CUSTOMERS_UPDATE
  PRODUCTS_READ
  PRODUCTS_CREATE
  PRODUCTS_UPDATE
  SALES_READ
  SALES_CREATE
  SALES_UPDATE
  SALES_FULFILL
  INVOICES_READ
  INVOICES_CREATE
  PAYMENTS_CREATE
  PAYMENTS_READ
  PAYMENTS_UPDATE
  PAYMENTS_DELETE
  EXPENSES_CREATE
  AUDIT_READ
  INVENTORY_READ
  INVENTORY_CREATE
  REPORTS_READ
  SETTINGS_READ
  SETTINGS_UPDATE
  TENANTS_MANAGE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryTransactionType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Company {
  id        String  @id @default(uuid())
  name      String
  legalName String?
  email     String?
  phone     String?
  country   String  @default("Saudi Arabia")
  currency  String  @default("SAR")
  timezone  String  @default("Asia/Riyadh")

  users                  User[]
  roles                  Role[]
  customers              Customer[]
  products               Product[]
  salesOrders            SalesOrder[]
  invoices               Invoice[]
  inventoryTransactions  InventoryTransaction[]
  payments               Payment[]
  settings               CompanySettings?
  auditLogs              AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  description String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id        String @id @default(uuid())
  companyId String
  roleId    String

  firstName    String
  lastName     String?
  email        String
  username     String
  passwordHash String

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@unique([companyId, username])
  @@index([companyId])
  @@index([roleId])
}

model Customer {
  id        String @id @default(uuid())
  companyId String

  name      String
  email     String?
  phone     String?
  city      String?
  industry  String?
  vatNumber String?
  status    CustomerStatus @default(LEAD)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]
  invoices    Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model Product {
  id        String @id @default(uuid())
  companyId String

  sku          String
  name         String
  description  String?
  category     String?
  costPrice    Decimal       @db.Decimal(12, 2)
  salePrice    Decimal       @db.Decimal(12, 2)
  stockQty     Int           @default(0)
  reorderLevel Int           @default(5)
  status       ProductStatus @default(ACTIVE)

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrderItems       SalesOrderItem[]
  inventoryTransactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
}

model SalesOrder {
  id          String           @id @default(uuid())
  companyId   String
  customerId  String
  status      SalesOrderStatus @default(DRAFT)
  totalAmount Decimal          @db.Decimal(12, 2)
  notes       String?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id])
  items    SalesOrderItem[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Invoice {
  id           String  @id @default(uuid())
  companyId    String
  customerId   String
  salesOrderId String?
  invoiceNo    String

  status     InvoiceStatus @default(DRAFT)
  total      Decimal       @db.Decimal(12, 2)
  paidAmount Decimal       @default(0) @db.Decimal(12, 2)
  balance    Decimal       @db.Decimal(12, 2)
  dueDate    DateTime

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, invoiceNo])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

model InventoryTransaction {
  id        String                   @id @default(uuid())
  companyId String
  productId String
  type      InventoryTransactionType
  quantity  Int
  reference String?
  notes     String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(uuid())
  companyId     String
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        PaymentStatus @default(PENDING)
  paymentDate   DateTime      @default(now())
  notes         String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([invoiceId])
}

model CompanySettings {
  id            String  @id @default(uuid())
  companyId     String  @unique
  companyName   String?
  logo          String?
  phone         String?
  email         String?
  address       String?
  currency      String  @default("SAR")
  timezone      String  @default("Asia/Riyadh")
  invoicePrefix String  @default("INV")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String        @id @default(uuid())
  key         PermissionKey @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AuditLog {
  id String @id @default(uuid())

  companyId String
  userId    String?

  action    String
  entity    String
  entityId  String?

  beforeJson Json?
  afterJson  Json?
  ipAddress  String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
