generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id        String  @id @default(uuid())
  name      String
  legalName String?
  email     String?
  phone     String?
  country   String  @default("Saudi Arabia")
  currency  String  @default("SAR")
  timezone  String  @default("Asia/Riyadh")

  users     User[]
  roles     Role[]
  customers Customer[]
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  companyId   String
  name        String
  description String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model User {
  id        String @id @default(uuid())
  companyId String
  roleId    String

  firstName    String
  lastName     String?
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, email])
  @@index([companyId])
  @@index([roleId])
}

model Customer {
  id        String @id @default(uuid())
  companyId String

  name      String
  email     String?
  phone     String?
  city      String?
  industry  String?
  vatNumber String?
  status    CustomerStatus @default(LEAD)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

model Product {
  id        String @id @default(uuid())
  companyId String

  sku          String
  name         String
  description  String?
  category     String?
  costPrice    Decimal       @db.Decimal(12, 2)
  salePrice    Decimal       @db.Decimal(12, 2)
  stockQty     Int           @default(0)
  reorderLevel Int           @default(5)
  status       ProductStatus @default(ACTIVE)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
}
